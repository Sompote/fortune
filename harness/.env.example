# Copy to harness/.env and fill in. Never commit .env.
OPENROUTER_API_KEY=sk-or-v1-your-key
# Any OpenRouter model id works; Thai quality is best on Claude Sonnet / GPT class models.
MORDOO_MODEL=anthropic/claude-sonnet-4.5
# Extra JSON merged into every LLM request (OpenRouter reasoning models). Set to {} to disable.
# MORDOO_LLM_EXTRA_BODY={"reasoning": {"effort": "low"}}
# Token the web backend uses to talk to the headless harness (any long random string).
ACCESS_TOKEN=change-me-to-a-long-random-secret
PORT=3001
# Path to the TigrimOS binary (built from ~/ENV3/structure_pondus/pondus with `cargo build --release -p tigrimos`).
TIGRIMOS_BIN=/Users/sompoteyouwai/ENV3/structure_pondus/pondus/target/release/tigrimos
